{
  "name": "skills-space",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "build": "pnpm run stage:upstream && tsc && vite build",
    "dev": "vite",
    "test:frontend-contracts": "pnpm run test:upstream && pnpm run test:appearance && pnpm run test:error-summary && pnpm run test:execution-log && pnpm run test:pi && pnpm run test:skill-document && pnpm run test:dialog-results && pnpm run test:dsh && pnpm run test:hermes && pnpm run test:overlays",
    "stage:upstream": "node scripts/stage-upstream.mjs",
    "test:upstream": "node --experimental-strip-types --test src/lib/upstream.test.ts src/lib/agent-skill-actions.test.ts src/lib/codex.test.ts src/lib/codex-defaults.test.ts src/lib/directory-diagnostics.test.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:native": "cargo test --offline --manifest-path src-tauri/Cargo.toml --lib -- --test-threads=1",
    "test:appearance": "node --experimental-strip-types --test src/lib/appearance.test.ts",
    "test:error-summary": "node --experimental-strip-types --test src/lib/error-summary.test.ts src/lib/notification-message.test.ts",
    "test:execution-log": "node --experimental-strip-types --test src/lib/execution-log.test.ts",
    "test:pi": "node --experimental-strip-types --test src/lib/pi.test.ts && node --test scripts/pi-skills.test.mjs scripts/pi-visibility.test.mjs scripts/pi-invocation-state.test.mjs",
    "test:dialog-results": "node --test scripts/dialog-results.test.mjs",
    "test:skill-document": "node --experimental-strip-types --test src/lib/skill-document.test.ts && node --test scripts/skill-document.test.mjs",
    "test:dsh": "node --experimental-strip-types --test src/lib/dsh.test.ts && node --test scripts/dsh-skills.test.mjs",
    "test:hermes": "node --experimental-strip-types --test src/lib/hermes.test.ts && node --test scripts/hermes-skills.test.mjs",
    "test:overlays": "node --test scripts/overlay-hints.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@lobehub/icons": "^5.15.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ignore": "7.0.8",
    "lucide-react": "^1.27.0",
    "minimatch": "10.2.6",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.15.0",
    "shiki": "4.3.1",
    "skills": "1.7.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
